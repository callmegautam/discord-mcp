# Bot token from https://discord.com/developers/applications (Bot tab)
DISCORD_TOKEN=

# Optional. Server the tools use when no guild_id is passed.
DISCORD_GUILD_ID=

# Optional. Comma separated server IDs the bot may act in. Empty means all of them.
ALLOWED_GUILD_IDS=

# Optional. true exposes only read-only tools.
READ_ONLY=

# Optional. true requests the privileged Message Content intent so message tools can read
# what other users wrote. Enable it in the developer portal first.
MESSAGE_CONTENT=

# Optional. Comma separated tool names to switch off.
DISABLED_TOOLS=

# Optional. debug, info, warn or error. Defaults to info.
LOG_LEVEL=

# Optional. stdio (default) for one process per MCP client, or http for a long running server.
TRANSPORT=

# Only with TRANSPORT=http. Clients send it as "Authorization: Bearer <token>". Required in http
# mode, at least 32 characters. Generate one with: openssl rand -hex 32
HTTP_TOKEN=

# Only with TRANSPORT=http. Defaults to 127.0.0.1 and 3000 (0.0.0.0 inside the docker image).
HTTP_HOST=
HTTP_PORT=

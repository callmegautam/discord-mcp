{
  "name": "discord-mcp",
  "version": "1.3.0",
  "description": "Self-hosted MCP server for managing a Discord server through a bot",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Gautam Suthar",
  "module": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "test:integration": "INTEGRATION=1 bun test tests/integration --timeout 60000",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun test",
    "docs:tools": "bun run scripts/tool-reference.ts",
    "docker:build": "docker build -t discord-mcp ."
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "discord.js": "14.27.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.4.3",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
